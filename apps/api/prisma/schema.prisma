generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Department {
  id                Int       @id @default(autoincrement()) @db.UnsignedInt
  name              String    @unique(map: "dept_name") @db.VarChar(100)
  code              String    @unique(map: "dept_code") @db.VarChar(20)
  head_id           Int?      @unique(map: "uq_dept_head") @db.UnsignedInt
  created_at        DateTime? @default(now()) @db.Timestamp(0)
  head              User?     @relation("DepartmentHead", fields: [head_id], references: [id], onDelete: SetNull, map: "dept_head_fk")
  users             User[]    @relation("UserDepartment")
  courses           Course[]
  classes           Class[]

  @@index([head_id], map: "idx_dept_head")
  @@map("departments")
}

model Semester {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  name          String    @db.VarChar(100)
  academic_year String    @db.VarChar(20)
  term          Term
  start_date    DateTime  @db.Date
  end_date      DateTime  @db.Date
  is_active            Boolean   @default(true)
  created_at           DateTime? @default(now()) @db.Timestamp(0)
  courses              Course[]
  timetable_slots      TimetableSlot[]
  enrollments          Enrollment[]
  faculty_availabilities FacultyAvailability[]

  @@unique([term, academic_year], name: "uq_semester")
  @@map("semesters")
}

model User {
  id                     Int                   @id @default(autoincrement()) @db.UnsignedInt
  name                   String                @db.VarChar(100)
  email                  String                @unique(map: "email") @db.VarChar(150)
  password_hash          String                @db.VarChar(255)
  role                   Role
  department_id          Int?                  @db.UnsignedInt
  class_id               Int?                  @db.UnsignedInt
  created_at             DateTime?             @default(now()) @db.Timestamp(0)
  department             Department?           @relation("UserDepartment", fields: [department_id], references: [id], onDelete: SetNull, map: "users_dept_fk")
  class                  Class?                @relation(fields: [class_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "users_class_fk")
  headed_department      Department?           @relation("DepartmentHead")
  course_faculty         CourseFaculty[]
  enrollments            Enrollment[]
  faculty_availabilities FacultyAvailability[]
  timetable_slots        TimetableSlot[]

  @@index([department_id], map: "idx_user_dept")
  @@index([class_id], map: "idx_user_class")
  @@map("users")
}

model Course {
  id              Int             @id @default(autoincrement()) @db.UnsignedInt
  name            String          @db.VarChar(150)
  code            String          @unique(map: "code") @db.VarChar(20)
  department_id   Int?            @db.UnsignedInt
  semester_id     Int?            @db.UnsignedInt
  is_lab          Boolean         @default(false)
  created_at      DateTime?       @default(now()) @db.Timestamp(0)
  department      Department?     @relation(fields: [department_id], references: [id], onDelete: SetNull, map: "courses_dept_fk")
  semester        Semester?       @relation(fields: [semester_id], references: [id], onDelete: SetNull, map: "courses_sem_fk")
  course_faculty  CourseFaculty[]
  enrollments     Enrollment[]
  timetable_slots TimetableSlot[]

  @@index([department_id], map: "idx_course_dept")
  @@index([semester_id], map: "idx_course_sem")
  @@map("courses")
}

model TimetableSlot {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  course_id  Int       @db.UnsignedInt
  faculty_id Int       @db.UnsignedInt
  class_id   Int?      @db.UnsignedInt
  room       String    @db.VarChar(50)
  day        Day
  start_time DateTime  @db.Time(0)
  end_time   DateTime  @db.Time(0)
  semester_id Int?     @db.UnsignedInt
  created_at DateTime? @default(now()) @db.Timestamp(0)
  course     Course    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "timetable_slots_ibfk_1")
  faculty    User      @relation(fields: [faculty_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "timetable_slots_ibfk_2")
  class      Class?    @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "timetable_slots_class_fk")
  semester   Semester? @relation(fields: [semester_id], references: [id], onDelete: SetNull, map: "timetable_slots_sem_fk")

  @@unique([course_id, faculty_id, day, start_time], name: "uq_slot", map: "uq_slot")
  @@index([faculty_id], map: "faculty_id")
  @@index([class_id], map: "idx_slot_class")
  @@index([day, start_time], map: "idx_day_time")
  @@index([room], map: "idx_room")
  @@index([semester_id], map: "idx_slot_sem")
  @@map("timetable_slots")
}

model Enrollment {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  student_id  Int       @db.UnsignedInt
  course_id   Int       @db.UnsignedInt
  semester_id Int?      @db.UnsignedInt
  enrolled_at DateTime? @default(now()) @db.Timestamp(0)
  student     User      @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "enrollments_ibfk_1")
  course      Course    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "enrollments_ibfk_2")
  semester    Semester? @relation(fields: [semester_id], references: [id], onDelete: SetNull, map: "enrollments_sem_fk")

  @@unique([student_id, course_id], name: "uq_enrollment", map: "uq_enrollment")
  @@index([course_id], map: "course_id")
  @@index([semester_id], map: "idx_enroll_sem")
  @@map("enrollments")
}

model Room {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  name         String    @unique(map: "name") @db.VarChar(50)
  capacity     Int       @default(30) @db.UnsignedInt
  is_lab       Boolean   @default(false)
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  classes_home Class[]   @relation("ClassHomeRoom")

  @@map("rooms")
}

model Class {
  id              Int             @id @default(autoincrement()) @db.UnsignedInt
  name            String          @db.VarChar(50)
  department_id   Int             @db.UnsignedInt
  home_room_id    Int?            @db.UnsignedInt
  created_at      DateTime?       @default(now()) @db.Timestamp(0)
  department      Department      @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "classes_dept_fk")
  home_room       Room?           @relation("ClassHomeRoom", fields: [home_room_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "classes_homeroom_fk")
  users           User[]
  timetable_slots TimetableSlot[]

  @@index([department_id], map: "idx_class_dept")
  @@index([home_room_id], map: "idx_class_homeroom")
  @@map("classes")
}

model CourseFaculty {
  id         Int    @id @default(autoincrement()) @db.UnsignedInt
  course_id  Int    @db.UnsignedInt
  faculty_id Int    @db.UnsignedInt
  course     Course @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "course_faculty_ibfk_1")
  faculty    User   @relation(fields: [faculty_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "course_faculty_ibfk_2")

  @@unique([course_id, faculty_id], name: "uq_course_faculty", map: "uq_course_faculty")
  @@index([faculty_id], map: "faculty_id")
  @@map("course_faculty")
}

model FacultyAvailability {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  faculty_id Int      @db.UnsignedInt
  day        Day
  start_time DateTime @db.Time(0)
  end_time   DateTime @db.Time(0)
  semester_id Int?    @db.UnsignedInt
  faculty    User     @relation(fields: [faculty_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "faculty_availability_ibfk_1")
  semester   Semester? @relation(fields: [semester_id], references: [id], onDelete: SetNull, map: "faculty_avail_sem_fk")

  @@unique([faculty_id, day], name: "uq_faculty_day", map: "uq_faculty_day")
  @@index([semester_id], map: "idx_avail_sem")
  @@map("faculty_availability")
}

enum Role {
  admin
  faculty
  student
}

enum Day {
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

enum Term {
  FALL
  SPRING
  SUMMER
}
