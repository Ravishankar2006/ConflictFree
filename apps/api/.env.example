# Application
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=smart_timetable

# Prisma reads this one; keep it in sync with the DB_* values above.
# Inside docker compose the host is the `db` service, not localhost.
DATABASE_URL="mysql://root:your_secure_password_here@localhost:3306/smart_timetable?allowPublicKeyRetrieval=true&ssl-mode=DISABLED"

# Security — CHANGE THIS before deploying!
JWT_SECRET=change_this_to_a_long_random_string_in_production

# CORS — set to your frontend URL in production
CORS_ORIGIN=http://localhost:5173
